# Copiare questo file in .env (Copy-Item .env.example .env) e adattarlo.
# Nessuna credenziale: LM Studio non richiede una chiave API.

# Indirizzo dell'API compatibile con OpenAI di LM Studio (con lo schema, senza barra finale).
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Identificativo del modello: deve coincidere con uno dei "id" restituiti da GET /v1/models.
LMSTUDIO_MODEL=google/gemma-4-e4b

# Fuso orario IANA usato dallo strumento orologio.
APP_TIMEZONE=Europe/Rome

# Modalità iniziale dei log. INFO = mostra i passaggi del grafo; WARNING = solo il dialogo.
# Facoltativa (default INFO). In chat il comando /log passa dall'una all'altra per la sessione.
LOG_LEVEL=INFO

# Indirizzo del servizio delle note (python -m note_api). Facoltativa (default http://localhost:8000).
NOTE_API_URL=http://localhost:8000
